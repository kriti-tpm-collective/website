# Sanity CMS — create a free project at https://www.sanity.io/manage
# Then run: npx sanity@latest init  (or paste IDs below)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Optional: read token for private datasets / drafts
# SANITY_API_READ_TOKEN=

# Newsletter (optional — https://buttondown.com)
# BUTTONDOWN_API_KEY=

# Site
NEXT_PUBLIC_SITE_URL=https://www.tpmcollective.org

# Signs member login sessions. Use a long random string in production.
# If unset, the app creates data/session.secret on first run.
# AUTH_SECRET=
